{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": [
    "main"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track dxflrs/garage image tag+digest pins across operator defaults, samples, e2e, and docs",
      "managerFilePatterns": [
        "/internal/controller/garagecluster_controller\\.go/",
        "/api/v1beta1/garagecluster_types\\.go/",
        "/config/samples/.+\\.yaml/",
        "/hack/test-resources\\.yaml/",
        "/test/e2e/e2e_test\\.go/",
        "/charts/garage-operator/values\\.yaml/",
        "/charts/garage-operator/README\\.md/",
        "/README\\.md/",
        "/docs/getting-started/quickstart\\.md/",
        "/docs/getting-started/installation\\.md/",
        "/docs/operations/upgrades\\.md/",
        "/docs/reference/compatibility\\.md/",
        "/docs/index\\.md/",
        "/cmd/main\\.go/"
      ],
      "matchStrings": [
        "dxflrs/garage:(?<currentValue>v[\\d.]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "depNameTemplate": "dxflrs/garage",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track defaultGarageTag so repository-only imageRepository defaults stay aligned (bare tag, no digest slot)",
      "managerFilePatterns": [
        "/internal/controller/garagecluster_controller\\.go/"
      ],
      "matchStrings": [
        "defaultGarageTag\\s*=\\s*\"(?<currentValue>v[\\d.]+)\""
      ],
      "depNameTemplate": "defaultGarageTag",
      "packageNameTemplate": "dxflrs/garage",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["sigs.k8s.io/container-object-storage-interface/proto"],
      "enabled": false,
      "description": "Pinned to a pseudo-version with unreleased API; tagged releases (v0.2.2) are older"
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["sigs.k8s.io/container-object-storage-interface/client"],
      "enabled": false,
      "description": "Pinned to a pseudo-version with the required v1alpha2 API; tagged v0.2.2 only contains v1alpha1"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "k8s",
      "matchPackageNames": [
        "/k8s.io/*/",
        "/sigs.k8s.io/*/"
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "actions",
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "major-actions"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["dxflrs/garage"],
      "groupName": "garage",
      "pinDigests": true,
      "description": "Group Garage image bumps; keep tag and digest pins in the same PR"
    },
    {
      "matchDepNames": ["defaultGarageTag"],
      "groupName": "garage",
      "pinDigests": false,
      "description": "defaultGarageTag is a bare tag constant with nowhere to put a digest; pinning it yields a no-op 'pin dxflrs/garage' update that fails with 'update failure'"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["example.com/**"],
      "enabled": false,
      "description": "example.com images are test/e2e placeholders, not real registries"
    }
  ]
}
